# -------------------------------------------------------------------
# 1. Public Portfolio Demo (Zero Login, Curated Fixtures)
# -------------------------------------------------------------------
{$DOMAIN_DEMO:demo.openeval.studio} {
    reverse_proxy openeval-demo:8001 {
        flush_interval -1
    }

    encode gzip zstd

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy no-referrer-when-downgrade
    }
}

# -------------------------------------------------------------------
# 2. Private Live Studio (Authenticated + IDE Webhook Exemption)
# -------------------------------------------------------------------
{$DOMAIN_LIVE:openeval.studio} {
    # Allow local IDE telemetry hooks through directly (authenticated via API token)
    @api_webhook {
        path /api/watcher/* /api/gate/* /api/health /api/demo/status
    }
    handle @api_webhook {
        reverse_proxy openeval-live:8000 {
            flush_interval -1
        }
    }

    # Protect all UI dashboard routes with Basic Authentication
    handle {
        basicauth {
            {$ADMIN_USER:jayson} {$ADMIN_PASSWORD_HASH}
        }
        reverse_proxy openeval-live:8000 {
            flush_interval -1
        }
    }

    encode gzip zstd

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer-when-downgrade
    }
}
