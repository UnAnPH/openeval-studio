# Google AI Studio API Key (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (if evaluating OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# OpenEval Studio runtime gate optional integrations
OPENEVAL_WATCHER_USE_LLM=0
WATCHER_WEBHOOK_URL=
OPENEVAL_API_KEY=

# Seed DEMO session & eval fixtures (set to 1 for hosted demo / review)
OPENEVAL_DEMO_SEED=0

# Production Authentication & Database Persistence (AWS / Cloud)
ADMIN_USER=jayson
ADMIN_PASSWORD=
DATABASE_URL=
