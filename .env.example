# Google AI Studio API Key (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (if evaluating OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# OpenEval Studio runtime gate optional integrations
OPENEVAL_WATCHER_USE_LLM=0
WATCHER_WEBHOOK_URL=
OPENEVAL_API_KEY=

# Seed DEMO session & eval fixtures (set to 1 for hosted demo / review)
OPENEVAL_DEMO_SEED=0

# Storage directory (DuckDB + JSON session store; defaults to .runs/watcher or .runs/demo_watcher)
WATCHER_STORAGE_DIR=

# PostgreSQL Database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://openeval:openeval@127.0.0.1:5432/openeval

# Redis Pub/Sub Broadcast Layer (optional, falls back gracefully to in-memory queues)
REDIS_URL=redis://127.0.0.1:6379/0

# OpenCode Console Inference API (Free Models: GLM-5.3-Flash, DeepSeek V4.1 Flash, Big Pickle, etc.)
# Obtain key at https://opencode.ai/ (Keys -> Add Service Account -> Add API Key; starts with oc_sk_...)
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1

